# Same Firebase project as the EventSphere website.
# Copy the values from: Firebase Console > Project settings > Your apps > Web app (SDK setup and configuration).
# This is the same config the web app keeps in frontend/.env.local (the VITE_FIREBASE_* values).
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=eventsp-ea90b.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=eventsp-ea90b
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Public URL of the deployed website (used for share links and for event cover images the web app stores as "/images/...").
EXPO_PUBLIC_WEB_ORIGIN=https://eventsp-ea90b.web.app

# Optional: match the website's setting.
EXPO_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false

# Optional: local Firebase Emulator mode (npm run emulators in the web repo).
# On a real phone use your computer's LAN IP; the Android emulator uses 10.0.2.2.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
